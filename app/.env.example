# ============================================================
# LUMINA — Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores:
#     cp .env.example .env
# NOTA: .env está excluido de git. Nunca comitees claves reales.
# ============================================================

# ==========================================
# SERVIDOR
# ==========================================
# Puerto HTTP. Default en server.js: 3100 (el 3000 queda reservado para AsistenteIA)
PORT=3100
# Directorio escribible/persistente para los datos temporales de la beta.
# En producción debe apuntar a un disco persistente; la evolución recomendada es PostgreSQL.
DATA_DIR=

# ==========================================
# BUCLE ESTRATÉGICO AUTÓNOMO (v1)
# ==========================================
# Vigilancia periódica de misiones vencidas/bloqueadas (sin coste de IA).
# El barrido registra alertas en la actividad del CEO. Primer barrido a los 5 s.
VIGILANCIA_ENABLED=false
VIGILANCIA_INTERVAL_MS=21600000

# ==========================================
# SEGURIDAD
# ==========================================
# Clave de firma JWT. Obligatoria en producción y mínimo 32 caracteres.
JWT_SECRET=
# Orígenes web permitidos, separados por comas. Ejemplo:
# ALLOWED_ORIGINS=https://app.tudominio.com,https://tudominio.com
ALLOWED_ORIGINS=

# ==========================================
# IA — GROQ (proveedor principal)
# ==========================================
# Opcional en modo demo. Si falta, Lumina intenta el respaldo local configurado.
GROQ_API_KEY=

# Modelos por propósito. Todos opcionales; los valores de abajo
# son los DEFAULTS que usa server.js.
# GROQ_MODEL es el modelo de "razonamiento" base; REASONING_MODEL lo pisa si existe.
GROQ_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b
COMMAND_MODEL=openai/gpt-oss-20b
CHAT_MODEL=qwen/qwen3.6-27b
REASONING_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Timeout por petición a Groq (ms) y circuit breaker: número de fallos
# transitorios consecutivos para abrir el circuito y ms de enfriamiento.
GROQ_TIMEOUT_MS=30000
GROQ_CIRCUIT_UMBRAL=3
GROQ_CIRCUIT_ENFRIAMIENTO_MS=30000

# Modo demo: activa el usuario demo, datos de ejemplo y el cerebro guionado
# (permite usar la app sin GROQ_API_KEY ni Ollama). Solo para demos.
DEMO_MODE=false

# ==========================================
# IA — FALLBACK LOCAL (Ollama)
# ==========================================
# 'true' activa el respaldo local cuando Groq falla.
LOCAL_FALLBACK_ENABLED=true
# Modelo de Ollama que debe estar ya descargado ('ollama pull <modelo>').
LOCAL_FALLBACK_MODEL=gemma3:12b-it-qat
OLLAMA_URL=http://127.0.0.1:11434

# ==========================================
# MOTOR DE VOZ (TTS)
# ==========================================
# 'macos' (voz nativa del sistema) o 'elevenlabs' (API en la nube).
VOICE_ENGINE=macos
# 'system-default' o un nombre de voz macOS (ej: 'Monica', 'Jorge').
MACOS_SYSTEM_VOICE=system-default
# 'default' o palabras por minuto (ej: 175, 200).
MACOS_SYSTEM_VOICE_RATE=default

# ==========================================
# ELEVENLABS (opcional — TTS en la nube)
# ==========================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ==========================================
# GOOGLE CALENDAR (opcional)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/calendar/callback

# ==========================================
# SLACK (opcional)
# ==========================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ==========================================
# EMAIL / SENDGRID (opcional)
# ==========================================
SENDGRID_API_KEY=
EMAIL_FROM=noreply@lumina.app
